# On your computer: copy this file to .env.local (never commit .env.local) and restart the app.
# Online (Vercel): add the same names in Project, Settings, Environment Variables, then redeploy.
# Everything here is optional. Anything left empty simply shows "Not connected".
# Use forward slashes in paths, even on Windows. Step-by-step help: README and the Channels page.

# ---- Online app: login and saving (Supabase). Leave empty to run locally without login. ----
# From Supabase: Project Settings, API (Project URL and the publishable / anon key).
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# The one email address allowed to log in.
ALLOWED_EMAIL=

# ---- AI Secretary (Ollama cloud). Key from ollama.com, Settings, Keys. ----
OLLAMA_API_KEY=
# Optional, default gemma4:cloud (included in the free plan)
OLLAMA_MODEL=

# ---- Monthly marketing reports (Word .docx), read from your computer (local mode only; online you upload them) ----
# Month sub-folders are fine, e.g. D:/Report/2026/Sep - 2026/...
REPORTS_DIR=

# ---- Website (public pages, no key needed) ----
# WEBSITE_URL=https://www.klongphaifarm.com

# ---- Google Analytics 4 (read-only service account) ----
# On your computer: the key file path. It must live OUTSIDE this project folder.
GA4_PROPERTY_ID=
GA4_SERVICE_ACCOUNT_JSON_PATH=
# Online: paste the whole key file's contents here instead (Vercel keeps it encrypted).
# GA4_SERVICE_ACCOUNT_JSON=

# ---- Shop: products, prices and stock (read-only key) ----
# SHOP_PLATFORM is shopify or woocommerce.
SHOP_PLATFORM=
SHOP_URL=
SHOP_API_KEY=
# WooCommerce only:
SHOP_API_SECRET=
# Optional: stock at or below this number is "Low stock" (default 5)
SHOP_LOW_STOCK=

# ---- Facebook Page + Instagram (Meta Graph API, read-only token) ----
META_PAGE_ID=
META_PAGE_ACCESS_TOKEN=
META_IG_USER_ID=

# ---- LINE Official Account (Messaging API channel access token) ----
LINE_CHANNEL_ACCESS_TOKEN=

# ---- Turn off all channel reading (no internet calls) ----
# CHANNELS_DISABLED=1
